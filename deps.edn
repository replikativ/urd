{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; Content-addressed UUIDs, and the raw synchronous SHA-256 that
        ;; Nakamoto's proof-of-work check runs on. `hasch.core/sha256` appears
        ;; in 0.4.x only; 0.3.96 exposes no raw byte-level digest at all.
        org.replikativ/hasch {:mvn/version "0.4.102"}

        ;; Canonical CBOR. `urd.wire` signs RFC 8949 bytes rather than a
        ;; Clojure-specific hash, so that a client in another language can
        ;; produce a valid signature from a published specification. Declared
        ;; explicitly rather than leaned on transitively through kabel: urd
        ;; calls it directly, and a wire format should not change because a
        ;; networking dependency bumped a version.
        org.replikativ/boring {:mvn/version "0.1.27"}

        ;; Async operations
        org.replikativ/superv.async {:mvn/version "0.3.50"}

        ;; Storage for consensus log
        org.replikativ/konserve {:mvn/version "0.9.372"}

        ;; Portable Ed25519 for the verification edge. Channel-returning on
        ;; both platforms because Web Crypto is promise-based, which is exactly
        ;; why verification lives outside the pure state machine.
        org.replikativ/geheimnis {:mvn/version "0.2.37"}

        ;; P2P networking.
        ;;
        ;; The RELEASED coordinate, not a local root. urd uses `kabel.peer`,
        ;; `kabel.middleware.cbor`, `kabel.pubsub`, `kabel.pubsub.protocol` and
        ;; `kabel.http`, all of which it ships -- checked by running the
        ;; whole suite against it, integration tests and real sockets included.
        ;; `kabel.identity` is the piece that is NOT released, and it is
        ;; skuld's, not urd's.
        ;;
        ;; This matters beyond tidiness: a `:local/root` in the top-level
        ;; `:deps` is dropped from the generated pom, so an artifact built from
        ;; it is uninstallable. urd could not have been published at all while
        ;; this line was a path.
        org.replikativ/kabel {:mvn/version "0.3.108"}

        ;; HTTP server for Kabel WebSocket
        http-kit/http-kit {:mvn/version "2.8.0"}}

 :aliases
 {:test {:extra-paths ["test" "test/resources"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         ;; `^:integration` is EXCLUDED from the default run. Those tests stand
         ;; up real WebSocket servers and wait on real handshakes, and their
         ;; outcome depends on how loaded the machine is: the same code and the
         ;; same tests produced 1, 5, 10 and 7 failures on four consecutive
         ;; runs. A suite whose result varies run to run cannot tell you whether
         ;; a change was safe, which is the only thing a suite is for.
         ;;
         ;; They are not deleted and not weakened -- `clj -M:integration` runs
         ;; them. Most of what made them vary has since been fixed: the
         ;; stranded-peer bug in round-robin, the readiness predicate that took
         ;; the maximum subscriber count across topics instead of the minimum,
         ;; teardown that was not in a `finally`, and blocking takes inside go
         ;; blocks starving core.async's dispatch pool. Six consecutive runs now
         ;; give five clean and one hung in `stop-network!` -- a bound, not a
         ;; fix, and the reason they stay out of the default gate.
         :main-opts ["-m" "cognitect.test-runner" "--exclude" "integration"]
         :exec-fn cognitect.test-runner.api/test}

  ;; The real-network tests, on their own, with nothing else competing.
  :integration {:extra-paths ["test" "test/resources"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             org.clojure/test.check {:mvn/version "1.1.1"}}
                :main-opts ["-m" "cognitect.test-runner" "--include" "integration"]}

  ;; Run the portable (.cljc) tests under Node.
  ;;
  ;; This alias is not a nicety. urd claims to be a portable clj+cljs library,
  ;; and that claim was FALSE and untested for as long as the simulator existed:
  ;; ClojureScript's `bit-and` yields a signed 32-bit integer, so the seeded PRNG
  ;; produced different sequences on the two platforms, and therefore different
  ;; message delays, drop decisions and sampled peers. It survived because every
  ;; test that could have caught it was `.clj`. A portability claim that no CI
  ;; job exercises is not a claim, it is a comment.
  ;;
  ;;   clj -M:cljs-test
  :cljs-test {:extra-paths ["test"]
              :jvm-opts ["-Xss4m"]
              :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                           org.clojure/test.check {:mvn/version "1.1.1"}}
              ;; BUILD a file. Do NOT `-m` through cljs.main.
              ;;
              ;; `cljs.main -m <ns>` with `--target node` does not batch-run:
              ;; it boots a Node REPL environment and evaluates the program
              ;; through it. A thread dump of a run that looked like a slow
              ;; COMPILE was parked in
              ;;
              ;;     cljs.repl.node$node_eval -> LinkedBlockingQueue.take
              ;;
              ;; and once the runner calls `js/process.exit` -- which it must,
              ;; or node stays alive on core.async's timers -- the JVM side
              ;; blocks forever waiting for a response from a node process that
              ;; has gone. The suite PASSED and the command never returned,
              ;; which is the worst of both: a green run indistinguishable from
              ;; a hung one, and a gate that stalls behind it.
              ;;
              ;; Building to `--output-to` and handing the file to node has no
              ;; REPL in it, so the exit is just an exit. `target/cljs-test`
              ;; still caches analysis between builds.
              ;;
              ;;   clj -M:cljs-test && node target/cljs-test.js
              ;;
              ;; `bin/test-all` does both.
              :main-opts ["-m" "cljs.main"
                          "--target" "node"
                          "--output-dir" "target/cljs-test"
                          "--output-to" "target/cljs-test.js"
                          "--compile-opts" "{:optimizations :none}"
                          "--compile" "urd.cljs-test-runner"]}

  ;; An nREPL with every test path on the classpath, for ITERATION.
  ;;
  ;; `bin/test-all` is the gate and costs minutes -- five suites, real sockets,
  ;; a ClojureScript build and real datahike file stores. Running it after
  ;; every edit is the slow way to work and I did exactly that for a while.
  ;; From a REPL, one namespace is seconds:
  ;;
  ;;   clj -M:test-repl
  ;;   (require 'urd.consensus.runtime-effects-test :reload)
  ;;   (clojure.test/run-tests 'urd.consensus.runtime-effects-test)
  ;;
  ;; Measured on this repo: 5.9s warm, against ~40s for the equivalent
  ;; `clj -M -e`, which pays JVM startup and a full namespace load every time.
  :test-repl {:extra-paths ["test" "test-storage" "test/resources"]
              :extra-deps {nrepl/nrepl {:mvn/version "1.1.0"}
                           org.clojure/test.check {:mvn/version "1.1.1"}
                           org.replikativ/konserve {:local/root "../konserve"}}
              :main-opts ["-m" "nrepl.cmdline"]}

  ;; Storage faults, against konserve's OWN crash simulator.
  ;;
  ;; `konserve.simulation.crash` models the six crash points along the write
  ;; path (SQLite/RocksDB/CrashMonkey: every reported crash bug reproduced
  ;; after an fsync-like call), deterministically and with no RNG, and
  ;; `konserve.simulation.backing` injects errors and corruption from a seeded
  ;; generator. Both ship in konserve explicitly so downstream projects can
  ;; test against them, so urd uses them rather than growing its own: urd's
  ;; `sim.cljc` is the NETWORK simulator, complementing kabel, and konserve's
  ;; is the STORAGE one, complementing a real backend.
  ;;
  ;; The fault-injection APIs ship in Konserve 0.9.399.
  :storage-sim {:extra-paths ["test" "test-storage" "test/resources"]
                :extra-deps {org.replikativ/konserve {:mvn/version "0.9.399"}
                             io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             org.clojure/test.check {:mvn/version "1.1.1"}}
                :main-opts ["-m" "cognitect.test-runner" "-d" "test-storage"]}

  :dev {:extra-paths ["dev"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.1.0"}}}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}
                 io.github.borkdude/gh-release-artifact {:git/sha "b946558225a7839f6a0f644834e838e190dc2262"}
                 slipset/deps-deploy {:mvn/version "0.2.0"}}
          :ns-default build}

  ;; MACHINE-CHECKED PROOFS. Optional, and deliberately not a runtime
  ;; dependency.
  ;;
  ;; ansatz is JVM-only and urd is a portable clj+cljs library, so ansatz can
  ;; never be in `:deps`. It does not need to be: ansatz ERASES proofs and
  ;; emits ordinary Clojure, so what urd ships is the emitted function and this
  ;; alias is the justification, checked separately.
  ;;
  ;; `urd.proofs.may-sign` verifies AT LOAD TIME -- a broken proof is a failing
  ;; require -- and `may-sign-test` compares the emitted definition against the
  ;; hand-copied one in `urd.consensus.signing` exhaustively, which is the part
  ;; that can actually rot.
  ;;
  ;;   clj -M:proofs
  ;;
  ;; The proof alias uses the bundled Init tier and the omega tactic for
  ;; symbolic natural-number division in the quorum bound.
  :proofs {:extra-paths ["proofs"]
           :extra-deps {org.replikativ/ansatz {:mvn/version "0.2.654"}
                        metosin/malli {:mvn/version "0.16.4"}
                        io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
           :main-opts ["-m" "cognitect.test-runner" "-d" "proofs"]}

  :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "check"]}

  :ffix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
         :main-opts ["-m" "cljfmt.main" "fix"]}}}

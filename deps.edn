{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; Yggdrasil core - for SnapshotRef and HLC types
        org.replikativ/yggdrasil {:mvn/version "0.1.7"}

        ;; Cryptographic primitives for signatures
        buddy/buddy-core {:mvn/version "1.12.0-430"}
        buddy/buddy-sign {:mvn/version "3.6.1-359"}

        ;; Content-addressed UUIDs, and the raw synchronous SHA-256 that
        ;; Nakamoto's proof-of-work check runs on. `hasch.core/sha256` appears
        ;; in 0.4.x only; 0.3.96 exposes no raw byte-level digest at all.
        org.replikativ/hasch {:mvn/version "0.4.102"}

        ;; Async operations
        org.replikativ/superv.async {:mvn/version "0.3.50"}

        ;; Storage for consensus log
        org.replikativ/konserve {:mvn/version "0.9.345"}

        ;; P2P networking
        org.replikativ/kabel {:mvn/version "0.3.93"}

        ;; HTTP server for Kabel WebSocket
        http-kit/http-kit {:mvn/version "2.8.0"}}

 :aliases
 {:test {:extra-paths ["test" "test/resources"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Run the portable (.cljc) tests under Node.
  ;;
  ;; This alias is not a nicety. urd claims to be a portable clj+cljs library,
  ;; and that claim was FALSE and untested for as long as the simulator existed:
  ;; ClojureScript's `bit-and` yields a signed 32-bit integer, so the seeded PRNG
  ;; produced different sequences on the two platforms, and therefore different
  ;; message delays, drop decisions and sampled peers. It survived because every
  ;; test that could have caught it was `.clj`. A portability claim that no CI
  ;; job exercises is not a claim, it is a comment.
  ;;
  ;;   clj -M:cljs-test
  :cljs-test {:extra-paths ["test"]
              :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                           org.clojure/test.check {:mvn/version "1.1.1"}}
              :main-opts ["-m" "cljs.main"
                          "--target" "node"
                          "--output-dir" "target/cljs-test"
                          "--compile-opts" "{:optimizations :none}"
                          "-m" "urd.cljs-test-runner"]}

  :dev {:extra-paths ["dev"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.1.0"}}}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}
                 slipset/deps-deploy {:mvn/version "0.2.0"}}
          :ns-default build}

  :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "check"]}

  :ffix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
         :main-opts ["-m" "cljfmt.main" "fix"]}}}
